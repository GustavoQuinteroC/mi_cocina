# ============================================================
# Mi Cocina - variables de entorno
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# --- Aplicación ---
APP_ENV=prod                   # prod | dev (dev muestra errores en pantalla)
APP_URL=https://micocina.ejemplo.com
# Secreto interno (firmas, tokens). Genera uno con: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=

# --- Base de datos (MariaDB/MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mi_cocina
DB_USERNAME=root
DB_PASSWORD=

# --- OpenAI (generación de recetas) ---
# La key SOLO vive aquí. Si está vacía, la app funciona pero sin funciones de IA.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# true = usa la Responses API con web_search para "grounding" (recetas basadas en fuentes reales).
# false = usa Chat Completions con JSON estricto (sin búsqueda web).
OPENAI_USE_WEB_SEARCH=true
