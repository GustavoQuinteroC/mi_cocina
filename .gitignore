/api/contratacion/

# ----- Logs: ignorar contenido, conservar la carpeta y su bloqueo web -----
*.log
error_log
php_errors.log
/logs/*
!/logs/.gitkeep
!/logs/.htaccess

# ----- Herramientas de desarrollo, pruebas y bandera de instalación -----
